---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import { getSnapshotPaths } from '../../../lib/snapshots';
import type { ApiResponse, ItemMap } from '../../../lib/types';

export async function getStaticPaths() {
  return getSnapshotPaths();
}

const { date, time } = Astro.params;
const { sample } = Astro.props;
const generatedAt = sample.ts;

let allSamples: any[] = [];
let items: ItemMap = {};

try {
  const raw = readFileSync(join(process.cwd(), 'public/data/history.json'), 'utf-8');
  const parsed = JSON.parse(raw) as ApiResponse;
  allSamples = parsed.samples || [];
} catch {}

try {
  const raw = readFileSync(join(process.cwd(), 'public/data/items.json'), 'utf-8');
  const parsed = JSON.parse(raw) as { items?: ItemMap };
  items = parsed.items || {};
} catch {}
---

<Layout title={`AKKISERVER — ${date} ${time.replace('-', ':')}`}>
  <main class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
    <nav class="mb-8">
      <a
        href="/akkiserveritemlogs/latest/"
        class="inline-flex items-center gap-1 text-sm font-medium text-blue-400 hover:underline"
      >
        ← Latest
      </a>
    </nav>

    <header class="mb-10">
      <h1 class="text-2xl font-semibold tracking-tight text-gray-100">
        {sample.hour}
      </h1>
      <p class="mt-1 text-sm text-gray-500">
        Historical snapshot · {sample.unique.toLocaleString()} unique items · {sample.total.toLocaleString()} total
      </p>
    </header>

    <script
      is:inline
      type="application/json"
      id="snapshot-data"
      set:html={JSON.stringify({ samples: allSamples, generatedAt, items })}
    />

    <div id="loading" class="flex items-center justify-center gap-3 py-12 text-gray-500">
      <svg class="h-5 w-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="text-sm">Loading…</span>
    </div>

    <div id="dashboard-root"></div>
  </main>

  <script>
    async function load() {
      const dataEl = document.getElementById('snapshot-data');
      const loadingEl = document.getElementById('loading');
      const rootEl = document.getElementById('dashboard-root');

      if (!dataEl || !rootEl) return;

      const data = JSON.parse(dataEl.textContent || '');
      loadingEl?.classList.add('hidden');

      const React = await import('react');
      const ReactDOM = await import('react-dom/client');
      const { default: Dashboard } = await import('../../../components/Dashboard');

      const container = document.createElement('div');
      rootEl.appendChild(container);

      ReactDOM.createRoot(container).render(
        React.createElement(Dashboard, {
          samples: data.samples,
          generatedAt: data.generatedAt,
          items: data.items || {},
        })
      );
    }

    load();
  </script>
</Layout>