---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import type {
  LatestResponse,
  ApiResponse,
  LatestItemsResponse,
  ItemMap,
} from '../../lib/types';

let latestData: LatestResponse | null = null;
let historyData = [];
let items: ItemMap = {};

try {
  const raw = readFileSync(join(process.cwd(), 'public/data/latest.json'), 'utf-8');
  latestData = JSON.parse(raw) as LatestResponse;
} catch {}

try {
  const raw = readFileSync(join(process.cwd(), 'public/data/history.json'), 'utf-8');
  const parsed = JSON.parse(raw) as ApiResponse;
  historyData = parsed.samples || [];
} catch {}

try {
  const raw = readFileSync(join(process.cwd(), 'public/data/items.json'), 'utf-8');
  const parsed = JSON.parse(raw) as LatestItemsResponse;
  items = parsed.items || {};
} catch {}

const latest = latestData?.latest ?? null;
const generatedAt = latestData?.generatedAt ?? new Date().toISOString();
const allSamples = historyData.length > 0 ? historyData : latest ? [latest] : [];
---

<Layout title="AKKISERVER Item Logs">
  <main class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-gray-100 sm:text-4xl">
        AKKISERVER
      </h1>
      <p class="mt-1 text-sm text-gray-500">
        Item inventory snapshot
        {latest && (
          <span class="ml-1 text-gray-400">{latest.hour}</span>
        )}
      </p>
    </header>

    {latest ? (
      <script
        is:inline
        type="application/json"
        id="dashboard-data"
        set:html={JSON.stringify({ samples: allSamples, generatedAt, items })}
      />
    ) : (
      <div class="rounded-2xl border border-gray-800 bg-gray-900/40 p-16 text-center">
        <p class="text-sm text-gray-500">No data available yet.</p>
      </div>
    )}

    <div id="loading" class="flex items-center justify-center gap-3 py-12 text-gray-500">
      <svg class="h-5 w-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="text-sm">Loading…</span>
    </div>

    <div id="dashboard-root"></div>
  </main>

  {latest && (
    <script>
      async function load() {
        const dataEl = document.getElementById('dashboard-data');
        const loadingEl = document.getElementById('loading');
        const rootEl = document.getElementById('dashboard-root');

        if (!dataEl || !rootEl) return;

        const data = JSON.parse(dataEl.textContent || '');
        loadingEl?.classList.add('hidden');

        const React = await import('react');
        const ReactDOM = await import('react-dom/client');
        const { default: Dashboard } = await import('../../components/Dashboard');

        const container = document.createElement('div');
        rootEl.appendChild(container);

        ReactDOM.createRoot(container).render(
          React.createElement(Dashboard, {
            samples: data.samples,
            generatedAt: data.generatedAt,
            items: data.items || {},
          })
        );
      }

      load();
    </script>
  )}
</Layout>
