---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import type { LatestResponse, ApiResponse, HourlySample } from '../../lib/types';

let latestData: LatestResponse | null = null;
let historyData: HourlySample[] = [];

try {
  const rawLatest = readFileSync(join(process.cwd(), 'dist/data/latest.json'), 'utf-8');
  latestData = JSON.parse(rawLatest) as LatestResponse;
} catch {
  // data not available yet
}

try {
  const rawHistory = readFileSync(join(process.cwd(), 'dist/data/history.json'), 'utf-8');
  const parsed = JSON.parse(rawHistory) as ApiResponse;
  historyData = parsed.samples || [];
} catch {
  // data not available yet
}

const latest = latestData?.latest ?? null;
const generatedAt = latestData?.generatedAt ?? new Date().toISOString();
const latestSamples = latest ? [latest] : [];
const allSamples = historyData.length > 0 ? historyData : latestSamples;
---

<Layout title="AKKISERVER Item Logs - Latest">
  <main class="container mx-auto px-4 py-8">
    <div id="app" class="space-y-4">
      <h1 class="text-2xl font-bold">AKKISERVER Item Logs</h1>

      <div id="loading" class="flex items-center gap-3 text-gray-400 py-12 justify-center">
        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span>Loading dashboard...</span>
      </div>

      {latest && (
        <script is:inline type="application/json" id="dashboard-data" set:html={JSON.stringify({ samples: allSamples, generatedAt })} />
      )}

      <div id="dashboard-root"></div>

      {!latest && (
        <div class="rounded-2xl border border-gray-800 bg-gray-900/70 p-8 text-center">
          <p class="text-gray-400">No data available yet.</p>
        </div>
      )}
    </div>
  </main>

  {latest && (
    <script>
      async function load() {
        const dataEl = document.getElementById('dashboard-data');
        const loadingEl = document.getElementById('loading');
        const rootEl = document.getElementById('dashboard-root');

        if (!dataEl || !rootEl) return;

        const data = JSON.parse(dataEl.textContent || '');

        loadingEl?.classList.add('hidden');

        const React = await import('react');
        const ReactDOM = await import('react-dom/client');
        const { default: Dashboard } = await import('../../components/Dashboard');

        const container = document.createElement('div');
        rootEl.appendChild(container);

        const root = ReactDOM.createRoot(container);
        root.render(
          React.createElement(Dashboard, {
            samples: data.samples,
            generatedAt: data.generatedAt,
          })
        );
      }

      load();
    </script>
  )}
</Layout>
